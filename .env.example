# Copy to .env and fill in. NEVER commit .env — it holds a real key.
# Base URL from AI Server's Server page. Must end in /v1.
AISERVER_BASE_URL=http://localhost:11436/v1
# Issue this in AI Server -> API keys. Required for any server that serves a network.
AISERVER_API_KEY=
# Optional: skip model discovery and pin one id (e.g. enginea/qwen2.5/1.5b).
AISERVER_MODEL=
